{
  "manifest_version": 3,
  "name": "YouTube Cleaner",
  "version": "0.2.0",
  "description": "Hides YouTube Shorts and filters bait and slop out of your feed with a cheap LLM, so YouTube's recommendations stay but the junk goes.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "YouTube Cleaner settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://opencode.ai/*", "https://openrouter.ai/*", "https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/shared/core.js", "src/content/panel.js", "src/content/main.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_start"
    }
  ]
}
