# Copy to .env and fill in. .env is git-ignored.

# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key (restrict it to YouTube Data API v3).
YOUTUBE_API_KEY=

# The same LLM key X IQ Slider uses. Fill in one of the two.
OPENROUTER_API_KEY=
OPENCODE_API_KEY=

# Optional. Defaults to the model X IQ Slider uses for the chosen provider.
# LLM_MODEL=
